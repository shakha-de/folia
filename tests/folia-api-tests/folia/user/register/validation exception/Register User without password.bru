meta {
  name: Register User without password
  type: http
  seq: 3
}

post {
  url: {{host}}/api/auth/register
  body: json
  auth: inherit
}

body:json {
  {
    "username":"username1",
    "email":"mymail@example.com"
  }
}

assert {
  res.status: eq 400
  res.body.success: eq false
  res.body.message: contains Validation failed
  res.body.data: isNull
  res.body.errors.Password: contains Password is required
}

settings {
  encodeUrl: true
  timeout: 0
}
