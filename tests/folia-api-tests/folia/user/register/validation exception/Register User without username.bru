meta {
  name: Register User without username
  type: http
  seq: 2
}

post {
  url: {{host}}/api/auth/register
  body: json
  auth: inherit
}

body:json {
  {
    "email":"mymail@example.com",
    "password":"somestrongpassword"
  }
}

assert {
  res.status: eq 400
  res.body.success: eq false
  res.body.message: contains Validation failed
  res.body.data: isNull
  res.body.errors.username: contains Username is required
}

settings {
  encodeUrl: true
  timeout: 0
}
