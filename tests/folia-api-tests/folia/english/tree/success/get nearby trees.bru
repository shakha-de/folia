meta {
  name: get nearby trees
  type: http
  seq: 6
}

get {
  url: {{host}}/api/trees/nearby?lat=51.48&lng=11.97&radiusMeters=20000
  body: none
  auth: bearer
}

params:query {
  lat: 51.48
  lng: 11.97
  radiusMeters: 20000
}

auth:bearer {
  token: {{user1Token}}
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.message: contains Nearby trees retrieved successfully
  res.body.data: length 4
  res.body.errors: isNull
}

settings {
  encodeUrl: true
  timeout: 0
}
