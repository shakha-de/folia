meta {
  name: Create a tree
  type: http
  seq: 1
}

post {
  url: {{host}}/api/trees
  body: json
  auth: bearer
}

auth:bearer {
  token: {{user1Token}}
}

body:json {
  {
    "species": "Quercus robur",
    "commonName": "Stieleiche",
    "lat": 51.4822,
    "lng": 11.9693,
    "soilMoistureLevel": "MODERATE",
    "healthStatus": "HEALTHY",
    "metadata": {
      "plantedDate": "2023-05-15",
      "caretakerId": "staff_042"
    }
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.message: contains Tree created successfully
  res.body.data.species: eq Quercus robur
  res.body.data.lat: eq 51.4822
  res.body.data.healthStatus: eq HEALTHY
  res.body.errors: isNull
}

settings {
  encodeUrl: true
  timeout: 0
}
