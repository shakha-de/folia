meta {
  name: Create a tree #4
  type: http
  seq: 4
}

post {
  url: {{host}}/api/trees
  body: json
  auth: bearer
}

auth:bearer {
  token: {{user1Token}}
}

body:json {
  {
    "species": "Betula pendula",
    "commonName": "Hängebirke",
    "lat": 51.4855,
    "lng": 11.9620,
    "soilMoistureLevel": "MODERATE",
    "healthStatus": "REMOVED",
    "metadata": {}
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.message: contains Tree created successfully
  res.body.data.species: eq Betula pendula
  res.body.data.lat: eq 51.4855
  res.body.data.healthStatus: eq REMOVED
  res.body.errors: isNull
}

settings {
  encodeUrl: true
  timeout: 0
}
