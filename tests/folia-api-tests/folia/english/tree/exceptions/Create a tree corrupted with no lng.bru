meta {
  name: Create a tree corrupted with no lng
  type: http
  seq: 4
}

post {
  url: {{host}}/api/trees
  body: json
  auth: bearer
}

auth:bearer {
  token: {{user1Token}}
}

body:json {
  {
    "species": "Quercus robur",
    "commonName": "Stieleiche",
    "lat": 51.4822,
    "soilMoistureLevel": "MODERATE",
    "healthStatus": "HEALTHY",
    "metadata": {
      "plantedDate": "2023-05-15",
      "caretakerId": "staff_042"
    }
  }
}

assert {
  res.status: eq 400
  res.body.success: eq false
  res.body.message: contains Validation failed.
  res.body.errors: isNotEmpty
  res.body.errors.lng: contains Longitude is required
}

settings {
  encodeUrl: true
  timeout: 0
}
