meta {
  name: login user #1 with false password
  type: http
  seq: 3
}

post {
  url: {{host}}/api/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "identifier":"username1",
    "password":"notstrongpassword"
  }
}

assert {
  res.status: eq 400
  res.body.success: eq false
  res.body.message: contains Invalid username or password
  res.body.data: isNull
}

settings {
  encodeUrl: true
  timeout: 0
}
