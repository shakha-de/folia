meta {
  name: login user #1 with username
  type: http
  seq: 1
}

post {
  url: {{host}}/api/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "identifier":"username1",
    "password":"somestrongpassword"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.token: isNotEmpty
  res.body.data.refreshToken: isNotEmpty
  res.body.data.user: isNotEmpty
  res.body.errors: isNull
  res.body.data.user.uuid: eq {{user1Obj.uuid}}
}

settings {
  encodeUrl: true
  timeout: 0
}
