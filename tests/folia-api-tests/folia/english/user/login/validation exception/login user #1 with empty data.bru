meta {
  name: login user #1 with empty data
  type: http
  seq: 3
}

post {
  url: {{host}}/api/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "identifier":"",
    "password":""
  }
}

assert {
  res.status: eq 400
  res.body.success: eq false
  res.body.message: contains Validation failed.
  res.body.data: isNull
  res.body.errors.Identifier: contains Username or Email is required
  res.body.errors.Password: contains Password is required
}

settings {
  encodeUrl: true
  timeout: 0
}
