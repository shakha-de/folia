meta {
  name: Register User #2 same username
  type: http
  seq: 2
}

post {
  url: {{host}}/api/auth/register
  body: json
  auth: inherit
}

body:json {
  {
    "username":"username1",
    "email":"mymail2@example.com",
    "password":"somestrongpassword"
  }
}

assert {
  res.status: eq 409
  res.body.success: eq false
  res.body.message: contains already taken
  res.body.data: isNull
}

settings {
  encodeUrl: true
  timeout: 0
}
