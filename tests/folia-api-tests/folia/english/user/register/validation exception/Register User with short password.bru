meta {
  name: Register User with short password
  type: http
  seq: 2
}

post {
  url: {{host}}/api/auth/register
  body: json
  auth: inherit
}

body:json {
  {
    "username":"username2",
    "email":"mymail@example.com",
    "password":"somestr"
  }
}

assert {
  res.status: eq 400
  res.body.success: eq false
  res.body.message: contains Validation failed.
  res.body.data: isNull
  res.body.errors.Password: contains Password is too weak
}

settings {
  encodeUrl: true
  timeout: 0
}
